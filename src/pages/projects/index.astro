---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectsTabs from '../../components/ProjectsTabs.jsx';
import { getProjects } from '../../lib/db';

const projects = await getProjects();
---

<BaseLayout
  title="Proyek | Adipra"
  description="Portofolio karya — UI/UX Design, Brand Design, Graphic Design, dan Web Development."
>
  <main class="relative mx-auto max-w-6xl overflow-hidden px-6 py-20 sm:py-28">
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-32 -right-24 h-96 w-96 rounded-full bg-primary/10 blur-3xl"></div>
      <div class="absolute top-1/2 -left-40 h-[28rem] w-[28rem] rounded-full bg-primary/5 blur-3xl"></div>
    </div>

    <section>
      <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
        Karya <span class="text-accent">Pilihan</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        Kumpulan proyek yang pernah saya kerjakan — dari desain antarmuka,
        identitas brand, desain grafis, hingga pengembangan web.
      </p>

      <ProjectsTabs client:load projects={projects} />
    </section>
  </main>
</BaseLayout>