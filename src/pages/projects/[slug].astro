---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft } from 'lucide-react';
import ProjectDetail from '../../components/ProjectDetail.jsx';
import { getProjects, getProjectById, generateSlug } from '../../lib/db';

export async function getStaticPaths() {
  const allProjects = await getProjects();
  const paths = [];
  const seenSlugs = new Set();

  for (const project of allProjects) {
    // Primary slug MUST be based on the project title
    const titleSlug = generateSlug(project.title);
    const candidateSlugs = [titleSlug, project.slug, project.id].filter(Boolean);

    // Aliases for Ikutaja legacy routes
    if (
      project.id === 'ikutaja-event-participant-management' ||
      titleSlug === 'ikutaja-event-participant-management'
    ) {
      candidateSlugs.push('ikutaja', 'ikut-aja', 'saya-ikut-aja', 'project-ikutaja');
    }

    for (const s of candidateSlugs) {
      if (s && !seenSlugs.has(s)) {
        seenSlugs.add(s);
        paths.push({
          params: { slug: s },
          props: { project, allProjects },
        });
      }
    }
  }

  return paths;
}

const { slug } = Astro.params;
const allProjects = Astro.props.allProjects || (await getProjects());
const project = Astro.props.project || (slug ? await getProjectById(slug) : null);

if (!project) {
  return Astro.redirect('/projects');
}

const otherProjects = allProjects
  .filter((p: any) => p.id !== project.id)
  .slice(0, 3);
---

<BaseLayout title={`${project.title} | Adipra`} description={project.description}>
  <main class="relative mx-auto max-w-6xl px-6 py-16 sm:py-24">
    <!-- Ambient Background Glow -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-primary/10 blur-[120px]"></div>
      <div class="absolute top-1/3 -left-32 h-[35rem] w-[35rem] rounded-full bg-primary/5 blur-[140px]"></div>
    </div>

    <!-- Navigation Back Button -->
    <a
      href="/projects"
      class="group inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-accent"
    >
      <ArrowLeft class="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-1" />
      <span>Kembali ke Proyek</span>
    </a>

    <!-- Dynamic Project Detail (SSR Initial Render + Realtime Supabase Sync) -->
    <ProjectDetail client:load initialProject={project} otherProjects={otherProjects} />
  </main>
</BaseLayout>
