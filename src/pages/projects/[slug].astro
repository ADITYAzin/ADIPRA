---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft, ArrowUpRight, Sparkles, ListTree } from 'lucide-react';
import { getProjects, getProjectById } from '../../lib/db';

export async function getStaticPaths() {
  const allProjects = await getProjects();
  return allProjects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { slug } = Astro.params;
const fetchedProject = await getProjectById(slug);
const allProjects = await getProjects();
const project = fetchedProject || Astro.props.project;

const categoryLabel = {
  uiux: 'UI/UX Design',
  brand: 'Brand Design',
  graphic: 'Graphic Design',
  web: 'Web Development',
}[project.category];

// Rekomendasi proyek lain
const otherProjects = allProjects
  .filter((p) => p.id !== project.id)
  .slice(0, 3);

// Pisahkan galeri proses pengembangan dan hasil akhir secara independen
const rawProcess = Array.isArray(project.process_images) ? project.process_images : [];
const rawResult = Array.isArray(project.result_images) ? project.result_images : [];
const legacyGallery = Array.isArray(project.gallery) ? project.gallery : [];

// Dukung penanda proc:: dan res:: jika tersimpan di kolom gallery Supabase
const taggedProcess = legacyGallery.filter((url) => typeof url === 'string' && url.startsWith('proc::')).map((url) => url.replace('proc::', ''));
const taggedResult = legacyGallery.filter((url) => typeof url === 'string' && url.startsWith('res::')).map((url) => url.replace('res::', ''));
const cleanLegacy = legacyGallery.map((url) => typeof url === 'string' ? url.replace(/^(proc|res)::/, '') : url);

const effectiveProcess = rawProcess.length > 0 ? rawProcess : taggedProcess;
const effectiveResult = rawResult.length > 0 ? rawResult : taggedResult;

const processImages = effectiveProcess.length > 0
  ? effectiveProcess
  : (effectiveResult.length === 0 && cleanLegacy.length > 1
      ? cleanLegacy.slice(0, Math.max(1, Math.floor(cleanLegacy.length / 2)))
      : []);

const resultImages = effectiveResult.length > 0
  ? effectiveResult
  : (effectiveProcess.length === 0 && cleanLegacy.length > 0
      ? (cleanLegacy.length === 1 ? cleanLegacy : cleanLegacy.slice(Math.max(1, Math.floor(cleanLegacy.length / 2))))
      : (cleanLegacy.length > 0 ? cleanLegacy : []));

// Navigasi subsection halaman (scroll navigation dinamis)
const pageSections = [
  { id: 'deskripsi-proyek', num: '01', label: 'Deskripsi Proyek' },
  ...(processImages.length > 0 ? [{ id: 'proses-pengembangan', num: '02', label: 'Proses Pengembangan' }] : []),
  ...(resultImages.length > 0 ? [{ id: 'hasil-akhir', num: processImages.length > 0 ? '03' : '02', label: 'Hasil Akhir' }] : []),
];
---

<BaseLayout title={`${project.title} | Adipra`} description={project.description}>
  <main class="relative mx-auto max-w-6xl px-6 py-16 sm:py-24">
    <!-- Ambient Background Glow -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 right-0 h-[30rem] w-[30rem] rounded-full bg-primary/10 blur-[120px]"></div>
      <div class="absolute top-1/3 -left-32 h-[35rem] w-[35rem] rounded-full bg-primary/5 blur-[140px]"></div>
    </div>

    <!-- Navigation Back Button -->
    <a
      href="/projects"
      class="group inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-accent"
    >
      <ArrowLeft class="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-1" />
      <span>Kembali ke Proyek</span>
    </a>

    <article class="mt-8">
      <!-- Clean & Atmospheric Hero Banner Card (Homepage Style) -->
      <header class="group relative overflow-hidden rounded-card bg-card shadow-soft-md transition-all duration-300">
        <!-- Cover Image with Gradient Overlay & Parallax feel -->
        <div class="relative h-64 sm:h-80 md:h-96 w-full overflow-hidden">
          <img
            src={project.cover}
            alt={`Cover proyek ${project.title}`}
            class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
          />
          <!-- Dark gradient overlays for high legibility -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/20"></div>

          <!-- Top Meta Badges -->
          <div class="absolute inset-x-0 top-0 z-10 flex items-center justify-between gap-3 p-5 sm:p-7">
            <span class="inline-flex rounded-full bg-primary px-3.5 py-1.5 text-xs font-semibold text-primary-foreground shadow-soft-sm">
              {categoryLabel}
            </span>
            <span class="font-display text-sm font-bold text-white/90">
              {project.year}
            </span>
          </div>

          <!-- Bottom Content overlay -->
          <div class="absolute inset-x-0 bottom-0 z-10 p-6 sm:p-10 flex flex-col justify-end gap-3">
            <h1 class="font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl tracking-tight leading-tight">
              {project.title}
            </h1>
            
            <!-- Tags Badges underneath Title -->
            <div class="flex flex-wrap items-center gap-2 pt-1">
              {
                project.tags.map((tag) => (
                  <span class="rounded-full bg-white/15 backdrop-blur-md px-3 py-1 text-xs font-medium text-white/90 border border-white/10">
                    {tag}
                  </span>
                ))
              }
            </div>

            {
              (project.category === 'web' || project.live_url || project.github_url) && (
                <div class="flex flex-wrap items-center gap-2.5 pt-2">
                  <a
                    href={project.live_url || project.url || '#'}
                    target={project.live_url || project.url ? '_blank' : undefined}
                    rel={project.live_url || project.url ? 'noopener noreferrer' : undefined}
                    class="inline-flex h-9 items-center gap-1.5 rounded bg-primary px-3.5 text-xs font-semibold text-primary-foreground shadow-soft-sm transition-all duration-200 hover:bg-primary/90"
                  >
                    <span>Buka Website</span>
                    <ArrowUpRight class="h-3.5 w-3.5" />
                  </a>
                  <a
                    href={project.github_url || project.repo_url || project.github || '#'}
                    target={project.github_url || project.repo_url || project.github ? '_blank' : undefined}
                    rel={project.github_url || project.repo_url || project.github ? 'noopener noreferrer' : undefined}
                    aria-label="Repository GitHub"
                    title="Repository GitHub"
                    class="inline-flex h-9 items-center gap-2 rounded bg-black px-3 text-xs font-semibold text-white shadow-soft-sm transition-all duration-200 hover:bg-black/80"
                  >
                    <svg role="img" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
                      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                    </svg>
                    <span>Repository GitHub</span>
                  </a>
                </div>
              )
            }
          </div>
        </div>
      </header>

      <!-- Layout Grid Dua Kolom (Konten Utama + Sidebar Proyek) -->
      <div class="mt-14 lg:grid lg:grid-cols-12 lg:gap-12">
        <!-- Main Content Area -->
        <div class="lg:col-span-8 space-y-16">
          <!-- Deskripsi Proyek -->
          <section id="deskripsi-proyek" class="scroll-mt-28">
            <div class="flex items-center gap-4">
              <span class="font-display text-sm font-semibold text-accent">01</span>
              <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
                Deskripsi Proyek
              </h2>
              <div class="h-px flex-1 bg-accent/25"></div>
            </div>
            <div class="mt-8 space-y-5 text-base sm:text-lg leading-relaxed text-muted-foreground">
              {
                (Array.isArray(project.detail)
                  ? project.detail
                  : project.detail.split('\n\n')
                ).map((paragraph) => <p class="text-left">{paragraph}</p>)
              }
            </div>
          </section>

          <!-- Proses Pengembangan -->
          {
            processImages.length > 0 && (
              <section id="proses-pengembangan" class="scroll-mt-28">
                <div class="flex items-center gap-4">
                  <span class="font-display text-sm font-semibold text-accent">02</span>
                  <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
                    Proses Pengembangan
                  </h2>
                  <div class="h-px flex-1 bg-accent/25"></div>
                </div>
                <div class="mt-10 grid gap-6 sm:grid-cols-2">
                  {
                    processImages.map((src, i) => (
                      <figure
                        class={`overflow-hidden rounded-card bg-card shadow-soft-md ${
                          i === 0 && processImages.length % 2 !== 0 ? 'sm:col-span-2' : ''
                        }`}
                      >
                        <img
                          src={src}
                          alt={`${project.title} — proses ${i + 1}`}
                          loading="lazy"
                          class="h-auto w-full object-cover"
                        />
                      </figure>
                    ))
                  }
                </div>
              </section>
            )
          }

          <!-- Hasil Akhir -->
          {
            resultImages.length > 0 && (
              <section id="hasil-akhir" class="scroll-mt-28">
                <div class="flex items-center gap-4">
                  <span class="font-display text-sm font-semibold text-accent">
                    {processImages.length > 0 ? '03' : '02'}
                  </span>
                  <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
                    Hasil Akhir
                  </h2>
                  <div class="h-px flex-1 bg-accent/25"></div>
                </div>
                <div class="mt-10 grid gap-6 sm:grid-cols-2">
                  {
                    resultImages.map((src, i) => (
                      <figure
                        class={`overflow-hidden rounded-card bg-card shadow-soft-md ${
                          i === 0 && resultImages.length === 1 ? 'sm:col-span-2' : ''
                        }`}
                      >
                        <img
                          src={src}
                          alt={`${project.title} — hasil akhir ${i + 1}`}
                          loading="lazy"
                          class="h-auto w-full object-cover"
                        />
                      </figure>
                    ))
                  }
                </div>
              </section>
            )
          }
        </div>

        <!-- Sidebar Right Column: Rekomendasi Proyek + Navigasi Halaman -->
        <aside class="mt-16 lg:mt-0 lg:col-span-4 lg:self-start">
          <div class="sticky top-24 space-y-6">
            <div class="rounded-card border border-border/80 bg-card/60 p-6 shadow-soft-md backdrop-blur-md">
            <div class="flex items-center justify-between gap-2 border-b border-border/60 pb-4">
              <div class="flex items-center gap-2">
                <Sparkles class="h-4 w-4 text-accent" />
                <h3 class="font-display text-lg font-bold text-foreground">Proyek Lainnya</h3>
              </div>
              <a
                href="/projects"
                class="text-xs font-semibold text-accent hover:underline inline-flex items-center gap-0.5"
              >
                Lihat Semua
                <ArrowUpRight class="h-3 w-3" />
              </a>
            </div>

            <div class="mt-5 space-y-4">
              {otherProjects.map((item) => (
                <a
                  href={`/projects/${item.id}`}
                  class="group flex items-center gap-3.5 rounded-xl border border-border/40 bg-background/50 p-2.5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-card hover:shadow-soft-sm"
                >
                  <img
                    src={item.cover}
                    alt={item.title}
                    class="h-16 w-16 shrink-0 rounded-lg object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                  <div class="min-w-0 flex-1">
                    <span class="text-[10px] font-semibold tracking-wider text-accent uppercase">
                      {
                        {
                          uiux: 'UI/UX',
                          brand: 'Brand',
                          graphic: 'Graphic',
                          web: 'Web',
                        }[item.category]
                      }
                    </span>
                    <h4 class="truncate font-display text-sm font-bold text-foreground transition-colors group-hover:text-accent">
                      {item.title}
                    </h4>
                    <p class="truncate text-xs text-muted-foreground mt-0.5">
                      {item.tags.slice(0, 2).join(' • ')}
                    </p>
                  </div>
                </a>
              ))}
            </div>
            </div>

            <!-- Panel Scroll Navigation: Navigasi Halaman -->
            <nav
              aria-label="Navigasi bagian halaman"
              class="rounded-card border border-border/80 bg-card/60 p-6 shadow-soft-md backdrop-blur-md"
            >
              <div class="flex items-center gap-2 border-b border-border/60 pb-4">
                <ListTree class="h-4 w-4 text-accent" />
                <h3 class="font-display text-lg font-bold text-foreground">Navigasi Halaman</h3>
              </div>

              <ul class="mt-4 space-y-1">
                {
                  pageSections.map((section) => (
                    <li>
                      <a
                        href={`#${section.id}`}
                        data-toc-link={section.id}
                        aria-current="false"
                        class="group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-muted-foreground transition-all duration-300 hover:bg-background/80 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring aria-[current=true]:bg-accent/10 aria-[current=true]:text-foreground"
                      >
                        <span class="h-px w-4 shrink-0 bg-border transition-all duration-300 group-hover:bg-accent group-hover:w-6 group-aria-[current=true]:w-6 group-aria-[current=true]:bg-accent" />
                        <span class="font-display text-xs font-bold">{section.num}</span>
                        <span class="font-medium">{section.label}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </div>
        </aside>
      </div>
    </article>
  </main>

  <script>
    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')
    );

    if (tocLinks.length > 0) {
      const targets = tocLinks
        .map((link) => document.getElementById(link.dataset.tocLink || ''))
        .filter((el): el is HTMLElement => el !== null);

      const lenisWindow = window as unknown as {
        __lenis?: { scrollTo: (target: HTMLElement, options?: object) => void };
      };

      const scrollToSection = (target: HTMLElement) => {
        if (lenisWindow.__lenis) {
          lenisWindow.__lenis.scrollTo(target, { offset: -96, duration: 1.2 });
        } else {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        history.replaceState(null, '', `#${target.id}`);
      };

      tocLinks.forEach((link) => {
        link.addEventListener('click', (event) => {
          const target = document.getElementById(link.dataset.tocLink || '');
          if (!target) return;
          event.preventDefault();
          scrollToSection(target);
        });
      });

      const setActive = (id: string) => {
        tocLinks.forEach((link) => {
          link.setAttribute(
            'aria-current',
            link.dataset.tocLink === id ? 'true' : 'false'
          );
        });
      };

      const pickActive = () => {
        const offset = 140;
        let current = targets[0]?.id ?? '';
        for (const target of targets) {
          if (target.getBoundingClientRect().top <= offset) current = target.id;
        }
        const atBottom =
          window.innerHeight + window.scrollY >=
          document.documentElement.scrollHeight - 4;
        if (atBottom && targets.length > 0) current = targets[targets.length - 1].id;
        setActive(current);
      };

      window.addEventListener('scroll', pickActive, { passive: true });
      window.addEventListener('resize', pickActive, { passive: true });
      pickActive();
    }
  </script>
</BaseLayout>