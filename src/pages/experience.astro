---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceTabs from '../components/ExperienceTabs.jsx';
import { getArticles, getCompetitions, getTrainings } from '../lib/db';

const articles = await getArticles();
const competitions = await getCompetitions();
const trainings = await getTrainings();
---

<BaseLayout title="Pengalaman | Adipra" description="Event, artikel, dan sertifikat Aditya.">
  <main class="relative mx-auto max-w-6xl overflow-hidden px-6 py-20 sm:py-28">
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-32 -right-24 h-96 w-96 rounded-full bg-primary/10 blur-3xl"></div>
      <div class="absolute top-1/2 -left-40 h-[28rem] w-[28rem] rounded-full bg-primary/5 blur-3xl"></div>
    </div>

    <section>
      <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
        Event & Sertifikasi
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        Kumpulan event yang saya ikuti beserta sertifikat kompetisi dan pelatihan.
      </p>

      <ExperienceTabs
        client:load
        articles={articles}
        competitions={competitions}
        trainings={trainings}
      />
    </section>
  </main>
</BaseLayout>