---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft } from 'lucide-react';
import ArticleDetail from '../../components/ArticleDetail.jsx';
import { getArticles, getArticleById } from '../../lib/db';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { slug } = Astro.params;
const fetchedArticle = slug ? await getArticleById(slug) : null;
const article = fetchedArticle || Astro.props.article;

if (!article) {
  return Astro.redirect('/experience');
}
---

<BaseLayout title={`${article.title} | Adipra`} description={article.description}>
  <main class="relative mx-auto max-w-4xl overflow-hidden px-6 py-20 sm:py-24">
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-32 -right-24 h-96 w-96 rounded-full bg-primary/10 blur-3xl"></div>
      <div class="absolute top-1/2 -left-40 h-[28rem] w-[28rem] rounded-full bg-primary/5 blur-3xl"></div>
    </div>

    <a
      href="/experience"
      class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-accent"
    >
      <ArrowLeft class="h-4 w-4" />
      Kembali ke Pengalaman
    </a>

    <ArticleDetail client:load initialArticle={article} />
  </main>
</BaseLayout>

<style is:global>
  .article-body {
    max-width: 70ch;
    font-size: 1.0625rem;
    line-height: 1.9;
    color: var(--foreground);
  }

  .article-body > *:first-child {
    margin-top: 0;
  }

  .article-body p {
    margin: 1.4rem 0;
  }

  .article-body h2 {
    margin: 3rem 0 1.25rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .article-body h3 {
    margin: 2.25rem 0 1rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .article-body strong {
    font-weight: 600;
    color: var(--foreground);
  }

  .article-body a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.2s ease;
  }
  .article-body a:hover {
    opacity: 0.75;
  }

  .article-body ul,
  .article-body ol {
    margin: 1.4rem 0;
    padding-left: 1.6rem;
  }
  .article-body ul {
    list-style: disc;
  }
  .article-body ol {
    list-style: decimal;
  }
  .article-body li {
    margin: 0.5rem 0;
  }

  .article-body blockquote {
    margin: 1.75rem 0;
    border-left: 3px solid var(--accent);
    padding: 0.25rem 0 0.25rem 1.25rem;
    font-style: italic;
    color: var(--muted-foreground);
  }

  .article-body code {
    border-radius: 0.375rem;
    background: var(--muted);
    padding: 0.125rem 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .article-body pre {
    margin: 1.5rem 0;
    overflow-x: auto;
    border-radius: 0.75rem;
    background: var(--muted);
    padding: 1.25rem;
  }
  .article-body pre code {
    background: transparent;
    padding: 0;
  }

  .article-body hr {
    margin: 2.5rem 0;
    border-color: var(--border);
  }

  @media (prefers-reduced-motion: reduce) {
    .article-body a {
      transition: none;
    }
  }
</style>