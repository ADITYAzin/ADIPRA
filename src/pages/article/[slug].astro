---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft } from 'lucide-react';
import { marked } from 'marked';
import { getArticles } from '../../lib/db';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { title, description, date, category, tags = [], cover, content } = article;

const html = marked.parse(content);
const readingMinutes = Math.max(1, Math.round(content.split(/\s+/).length / 200));
const formattedDate = new Date(date).toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} | Adipra`} description={description}>
  <main class="relative mx-auto max-w-4xl overflow-hidden px-6 py-20 sm:py-24">
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-32 -right-24 h-96 w-96 rounded-full bg-primary/10 blur-3xl"></div>
      <div class="absolute top-1/2 -left-40 h-[28rem] w-[28rem] rounded-full bg-primary/5 blur-3xl"></div>
    </div>

    <a
      href="/experience"
      class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-accent"
    >
      <ArrowLeft class="h-4 w-4" />
      Kembali ke Pengalaman
    </a>

    <article class="mt-10">
      <header class="max-w-2xl">
        <div class="flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
          <span class="rounded-full bg-accent/10 px-3 py-1 font-medium text-accent">
            {category}
          </span>
          <time datetime={new Date(date).toISOString()}>{formattedDate}</time>
          <span aria-hidden="true">·</span>
          <span>{readingMinutes} menit baca</span>
        </div>
        <h1 class="mt-6 font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          {title}
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{description}</p>
      </header>

      <figure class="mt-10 overflow-hidden rounded-2xl border border-border shadow-card">
        <img src={cover} alt={`Cover artikel ${title}`} class="h-auto w-full object-cover" />
      </figure>

      <div class="article-body mt-12" set:html={html} />

      <footer class="mt-14 border-t border-border pt-8">
        <h2 class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-muted-foreground">
          Topik
        </h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            tags.map((tag) => (
              <span class="rounded-full border border-border px-3 py-1 text-sm text-muted-foreground">
                #{tag}
              </span>
            ))
          }
        </div>
      </footer>
    </article>
  </main>
</BaseLayout>

<style is:global>
  .article-body {
    max-width: 70ch;
    font-size: 1.0625rem;
    line-height: 1.9;
    color: var(--foreground);
  }

  .article-body > *:first-child {
    margin-top: 0;
  }

  .article-body p {
    margin: 1.4rem 0;
  }

  .article-body h2 {
    margin: 3rem 0 1.25rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .article-body h3 {
    margin: 2.25rem 0 1rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .article-body strong {
    font-weight: 600;
    color: var(--foreground);
  }

  .article-body a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.2s ease;
  }
  .article-body a:hover {
    opacity: 0.75;
  }

  .article-body ul,
  .article-body ol {
    margin: 1.4rem 0;
    padding-left: 1.6rem;
  }
  .article-body ul {
    list-style: disc;
  }
  .article-body ol {
    list-style: decimal;
  }
  .article-body li {
    margin: 0.5rem 0;
  }

  .article-body blockquote {
    margin: 1.75rem 0;
    border-left: 3px solid var(--accent);
    padding: 0.25rem 0 0.25rem 1.25rem;
    font-style: italic;
    color: var(--muted-foreground);
  }

  .article-body code {
    border-radius: 0.375rem;
    background: var(--muted);
    padding: 0.125rem 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .article-body pre {
    margin: 1.5rem 0;
    overflow-x: auto;
    border-radius: 0.75rem;
    background: var(--muted);
    padding: 1.25rem;
  }
  .article-body pre code {
    background: transparent;
    padding: 0;
  }

  .article-body hr {
    margin: 2.5rem 0;
    border-color: var(--border);
  }

  @media (prefers-reduced-motion: reduce) {
    .article-body a {
      transition: none;
    }
  }
</style>