---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Globe, LayoutGrid, Palette, ShieldCheck, WandSparkles } from 'lucide-react';

const education = [
  {
    school: 'SMP Muhammadiyah 10 Sidoarjo',
    degree: 'Sekolah Menengah Pertama',
    period: '2021 — 2023',
    note: 'Membangun dasar pendidikan dan karakter selama masa sekolah menengah pertama.',
  },
  {
    school: 'SMK Telkom Sidoarjo',
    degree: 'Sekolah Menengah Kejuruan - Teknik Jaringan Akses Telekomunikasi',
    period: '2024 — 2026',
    note: 'Memperdalam keahlian di bidang digital seperti UI/UX Design, Web Development, dan AI.',
  },
];

const experiences = [
  {
    role: 'Frontend Web Developer',
    company: 'Pekerja Lepas - Subur Berlimpah Sejahtera',
    period: 'Juli 2026 - Agustus 2026',
    note: 'Merancang sistem RFQ terpusat berbasis React.js dan Next.js yang terintegrasi dengan API WhatsApp/Email, sehingga menyederhanakan pemesanan lintas platform menjadi proses standarisasi format pesanan otomatis.',
  },
  {
    role: 'UI/UX Designer',
    company: 'Magang - PT Berkah Bersama Ikutaja',
    period: 'April 2026 - Mei 2026',
    note: 'Memimpin perancangan ulang menyeluruh (end-to-end) untuk alur pembuatan acara, pendaftaran komunitas, dan onboarding melalui riset pengguna serta tolok ukur kompetitor di tiga platform acara, sehingga menghasilkan antarmuka (UI) yang mudah dipahami, konsisten, dan meminimalkan hambatan interaksi.',
  },
];

const softSkills = [
  'Responsibility',
  'Teamwork',
  'Adaptable',
  'Problem Solving',
];

const hardSkills = [
  { name: 'UI/UX Design', level: 90, icon: LayoutGrid },
  { name: 'Graphic Design', level: 85, icon: Palette },
  { name: 'Frontend Web Development', level: 80, icon: Globe },
  { name: 'Quality Assurance', level: 78, icon: ShieldCheck },
  { name: 'Prompt Engineering', level: 82, icon: WandSparkles },
];

const tools = [
  { name: 'Figma', logo: '/images/assets/logos/logo-figma.svg' },
  { name: 'Gemini AI', logo: '/images/assets/logos/logo-gemini.svg' },
  { name: 'NotebookLM', logo: '/images/assets/logos/logo-notebooklm.svg', big: true },
  { name: 'OpenCode', logo: '/images/assets/logos/logo-opencode.svg' },
  { name: 'WordPress', logo: '/images/assets/logos/logo-wordpress.svg' },
  { name: 'Maze', logo: '/images/assets/logos/logo-maze.svg' },
  { name: 'Canva', logo: '/images/assets/logos/logo-canva.svg' },
  { name: 'HTML', logo: '/images/assets/logos/logo-html.svg' },
  { name: 'Tailwind CSS', logo: '/images/assets/logos/logo-tailwindcss.svg' },
  { name: 'Javascript', logo: '/images/assets/logos/logo-javascript.svg' },
  { name: 'Notion', logo: '/images/assets/logos/logo-notion.svg' },
  { name: 'Supabase', logo: '/images/assets/logos/logo-supabase.svg' },
  { name: '9Router', logo: '/images/assets/logos/9router-logo.png', left: true },
];

const aboutText = 'Saya menerapkan Design Thinking yang berpusat pada pengguna secara presisi, diperkuat oleh pemahaman teknis frontend dan pengujian kualitas produk. Mengadopsi teknologi AI untuk mempercepat riset dan iterasi desain, menciptakan alur kerja efisien yang mendukung tercapainya tujuan bisnis.';
---

<BaseLayout title="About | Adipra" description="Tentang Adipra — profil, pendidikan, dan keahlian.">
  <main class="relative mx-auto max-w-6xl overflow-hidden px-6 py-20 sm:py-28">
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-32 -right-24 h-96 w-96 rounded-full bg-accent/15 blur-3xl"></div>
      <div class="absolute top-1/2 -left-40 h-[28rem] w-[28rem] rounded-full bg-accent/10 blur-3xl"></div>
      <div class="absolute -bottom-24 right-1/3 h-80 w-80 rounded-full bg-accent/15 blur-3xl"></div>
    </div>

    <!-- Description -->
    <section class="flex min-h-[calc(100svh-10rem)] flex-col items-center justify-center py-10 sm:min-h-[calc(100svh-14rem)] sm:py-12">
      <div class="reveal flex flex-col items-center text-center" style="transition-delay: 120ms">
        <div class="relative">
          <div class="relative flex h-36 w-36 items-center justify-center overflow-hidden rounded-full border border-white/10 bg-primary ring-1 ring-accent/30 sm:h-40 sm:w-40">
            <img
              src="/images/assets/Transparant Profile.png"
              alt="Foto profil Aditya Pratama Putra"
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
        </div>

        <p class="mt-8 max-w-4xl text-2xl font-medium leading-relaxed text-foreground">
          {
            aboutText.split(' ').map((word, i) => (
              <span key={i} class="word-wrap">
                <span class="word" style={`transition-delay: ${120 + i * 22}ms`}>{word}</span>{' '}
              </span>
            ))
          }
        </p>
      </div>
    </section>

    <!-- Education -->
    <section id="pendidikan" class="mt-24">
      <div class="reveal flex items-center gap-4">
        <span class="font-display text-sm font-semibold text-accent">02</span>
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Pendidikan</h2>
        <div class="h-px flex-1 bg-accent/25"></div>
      </div>
      <div class="relative mt-10">
        <div class="absolute left-5 top-0 h-full w-px bg-accent/40 md:left-1/2"></div>
        <div class="space-y-10">
          {
            education.map((item, i) => (
              <div class={`reveal relative pl-16 md:w-1/2 md:pl-0 ${i % 2 === 0 ? 'md:pr-16' : 'md:ml-auto md:pl-16'}`} style={`transition-delay: ${i * 120}ms`}>
                <span class="absolute left-5 top-1 flex h-6 w-6 -translate-x-1/2 items-center justify-center md:left-1/2">
                  <span class="absolute h-6 w-6 rounded-full bg-accent/20 blur-sm"></span>
                  <span class="relative h-3 w-3 rounded-full border-2 border-white bg-accent shadow"></span>
                </span>
                <div class="glass-card p-7">
                  <span class="inline-block rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">{item.period}</span>
                  <h3 class="mt-3 font-display text-xl font-semibold">{item.school}</h3>
                  <p class="mt-1 text-sm font-medium text-accent">{item.degree}</p>
                  <p class="mt-3 leading-relaxed text-muted-foreground">{item.note}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Work Experience -->
    <section class="mt-24">
      <div class="reveal flex items-center gap-4">
        <span class="font-display text-sm font-semibold text-accent">03</span>
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Pengalaman Kerja</h2>
        <div class="h-px flex-1 bg-accent/25"></div>
      </div>
      <div class="relative mt-10">
        <div class="absolute left-5 top-0 h-full w-px bg-accent/40 md:left-1/2"></div>
        <div class="space-y-10">
          {
            experiences.map((item, i) => (
              <div class={`reveal relative pl-16 md:w-1/2 md:pl-0 ${i % 2 === 0 ? 'md:pr-16' : 'md:ml-auto md:pl-16'}`} style={`transition-delay: ${i * 120}ms`}>
                <span class="absolute left-5 top-1 flex h-6 w-6 -translate-x-1/2 items-center justify-center md:left-1/2">
                  <span class="absolute h-6 w-6 rounded-full bg-accent/20 blur-sm"></span>
                  <span class="relative h-3 w-3 rounded-full border-2 border-white bg-accent shadow"></span>
                </span>
                <div class="glass-card p-7">
                  <span class="inline-block rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">{item.period}</span>
                  <h3 class="mt-3 font-display text-xl font-semibold">{item.role}</h3>
                  <p class="mt-1 text-sm font-medium text-accent">{item.company}</p>
                  <p class="mt-3 leading-relaxed text-muted-foreground">{item.note}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section class="mt-24">
      <div class="reveal flex items-center gap-4">
        <span class="font-display text-sm font-semibold text-accent">04</span>
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Keahlian</h2>
        <div class="h-px flex-1 bg-accent/25"></div>
      </div>

      <div class="reveal mt-10 flex flex-wrap gap-2.5" style="transition-delay: 60ms">
        {
          softSkills.map((skill) => (
            <span class="skill-chip">{skill}</span>
          ))
        }
      </div>

      <!-- Hard Skills -->
      <div class="mt-8 grid grid-cols-3 gap-4">
        {
          hardSkills.map((skill, i) => {
            const Icon = skill.icon;
            return (
              <div
                class="reveal group flex flex-col gap-4 rounded-card bg-card p-6 text-center shadow-soft-md transition-all duration-300 hover:-translate-y-1 hover:shadow-soft-lg"
                style={`transition-delay: ${i * 80}ms`}
              >
                <div class="flex items-center justify-between">
                  <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-primary transition-transform duration-300 group-hover:scale-110">
                    <Icon class="size-6" />
                  </span>
                  <span class="relative text-accent">
                    <svg class="h-12 w-12 -rotate-90" viewBox="0 0 36 36">
                      <circle cx="18" cy="18" r="15.9155" fill="none" stroke="currentColor" stroke-opacity="0.15" stroke-width="3" />
                      <circle cx="18" cy="18" r="15.9155" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray={`${skill.level}, 100`} />
                    </svg>
                    <span class="absolute inset-0 flex items-center justify-center text-[11px] font-bold text-accent">
                      {skill.level}%
                    </span>
                  </span>
                </div>
                <p class="font-display text-md font-semibold leading-snug text-left">
                  {skill.name}
                </p>
              </div>
            )
          })
        }
      </div>
    </section>

    <!-- Tools -->
    <section class="mt-24">
      <div class="reveal flex items-center gap-4">
        <span class="font-display text-sm font-semibold text-accent">05</span>
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Tools</h2>
        <div class="h-px flex-1 bg-accent/25"></div>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {
          tools.map((tool, i) => (
            <div class="reveal glass-card tool-card p-6" style={`transition-delay: ${i * 70}ms`}>
              <span class={`flex h-12 items-center transition-transform duration-300 group-hover:scale-110 ${tool.left ? '' : 'w-16 justify-center'}`}>
                <img
                  src={tool.logo}
                  alt={`Logo ${tool.name}`}
                  loading="lazy"
                  class={`object-contain object-left ${tool.big ? 'h-12 w-16' : tool.left ? 'h-11' : 'h-9 w-14'}`}
                />
              </span>
              <p class="mt-4 font-display text-base font-semibold">{tool.name}</p>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .glass {
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 8px 32px rgba(37, 99, 235, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .glass-card {
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 1.5rem;
    box-shadow: 0 8px 32px rgba(37, 99, 235, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.7);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
  }
  .glass-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 48px rgba(37, 99, 235, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .glass-stat {
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 6px 24px rgba(37, 99, 235, 0.08);
    border-radius: 1.25rem;
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
  }
  .glass-stat:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 36px rgba(37, 99, 235, 0.16);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.875rem;
    background: #2563eb;
    color: #fff;
    padding: 0.875rem 1.75rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 600;
    font-size: 0.9375rem;
    box-shadow: 0 10px 30px rgba(37, 99, 235, 0.3);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease;
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 40px rgba(37, 99, 235, 0.4);
  }
  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.875rem;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    color: var(--foreground);
    padding: 0.875rem 1.75rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 600;
    font-size: 0.9375rem;
    box-shadow: 0 6px 24px rgba(37, 99, 235, 0.08);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease, background 0.3s ease;
  }
  .btn-ghost:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.75);
    box-shadow: 0 14px 36px rgba(37, 99, 235, 0.14);
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    font-size: 0.875rem;
    font-weight: 500;
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.06);
    transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
  }
  .skill-chip:hover {
    transform: translateY(-2px) scale(1.03);
    background: #2563eb;
    color: #fff;
    box-shadow: 0 10px 24px rgba(37, 99, 235, 0.28);
  }

  .skill-bar {
    animation: grow 1.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    transform-origin: left;
  }

  .tool-card {
    position: relative;
    overflow: hidden;
  }
  .tool-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 20%, rgba(37, 99, 235, 0.12), transparent 60%);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .tool-card:hover::before {
    opacity: 1;
  }

  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .word-wrap {
    display: inline;
  }
  .word {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.5em);
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }
  .reveal.revealed .word {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .word {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .glass-card,
    .glass-stat,
    .btn-primary,
    .btn-ghost,
    .skill-chip,
    .tool-card {
      transition: none;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>