---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminDashboard from '../components/AdminDashboard.jsx';
---

<BaseLayout title="Admin Dashboard | Adipra" description="Admin Dashboard to manage projects, certificates, articles, and training.">
  <main class="relative mx-auto max-w-[1400px] px-4 py-8 sm:px-6 lg:px-8">
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-32 -right-24 h-96 w-96 rounded-full bg-primary/10 blur-3xl"></div>
      <div class="absolute top-1/2 -left-40 h-[28rem] w-[28rem] rounded-full bg-primary/5 blur-3xl"></div>
    </div>

    <section class="mt-4">
      <AdminDashboard client:only="react" />
    </section>
  </main>
</BaseLayout>
