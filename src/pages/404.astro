---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Home, FolderKanban, ArrowLeft } from 'lucide-react';
---

<BaseLayout
  title="Halaman Tidak Ditemukan (404) | Adipra"
  description="Halaman yang Anda cari tidak dapat ditemukan."
>
  <main class="relative flex min-h-[75vh] flex-col items-center justify-center px-6 py-24 text-center">
    <!-- Ambient Background Glow -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-32 -right-24 h-96 w-96 rounded-full bg-primary/10 blur-3xl"></div>
      <div class="absolute top-1/2 -left-40 h-[28rem] w-[28rem] rounded-full bg-primary/5 blur-3xl"></div>
    </div>

    <!-- Error Code Badge -->
    <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-4 py-1.5 font-display text-sm font-bold tracking-widest text-primary uppercase">
      Error 404
    </span>

    <h1 class="mt-6 font-display text-4xl font-extrabold tracking-tight sm:text-6xl text-foreground">
      Halaman Tidak Ditemukan
    </h1>

    <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
      Rute tautan atau studi kasus yang kamu tuju mungkin telah dipindahkan, berganti slug, atau tidak lagi tersedia.
    </p>

    <!-- Navigation Options -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/"
        class="inline-flex h-11 items-center gap-2 rounded-xl bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-soft-sm transition-all duration-200 hover:bg-primary/90"
      >
        <Home className="h-4 w-4" />
        <span>Kembali ke Beranda</span>
      </a>

      <a
        href="/projects"
        class="inline-flex h-11 items-center gap-2 rounded-xl border border-border bg-card px-6 text-sm font-semibold text-foreground shadow-soft-sm transition-all duration-200 hover:border-primary/40 hover:bg-muted"
      >
        <FolderKanban className="h-4 w-4" />
        <span>Eksplorasi Proyek</span>
      </a>
    </div>

    <!-- Smart Auto-Recovery Script for Project URLs -->
    <script is:inline>
      (function() {
        try {
          const path = window.location.pathname.toLowerCase().replace(/\/+$/, '');
          // If the visitor was trying to view a project subpath that wasn't found
          if (path.startsWith('/projects/')) {
            const rawSlug = path.replace('/projects/', '').trim();
            // Fallback keywords mapping for instant recovery
            const quickRedirects = {
              'opilines': '/projects/opilines',
              'opiline': '/projects/opilines',
              'ikutaja': '/projects/ikutaja',
              'ikut-aja': '/projects/ikutaja',
              'sublims': '/projects/sublims',
              'sublims-profile': '/projects/sublims',
              'samling': '/projects/samling',
              'tasky': '/projects/tasky',
              'ssh': '/projects/ssh'
            };

            for (const [key, target] of Object.entries(quickRedirects)) {
              if (rawSlug.includes(key) && path !== target) {
                window.location.replace(target);
                break;
              }
            }
          }
        } catch (_) {}
      })();
    </script>
  </main>
</BaseLayout>
